---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import { Image } from "astro:assets";
import IconRss from "@/assets/icons/IconRss.svg";
import portrait from "@/assets/images/gregoire-hebert.jpg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { socials, posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout my-1"
  >
    <section id="hero" class="border-border border-b pt-8 pb-6">
      <h1 class="my-4 inline-block text-4xl font-bold sm:my-8 sm:text-5xl">
        Bonjour !
      </h1>
      <a
        target="_blank"
        href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}rss.xml`}
        class="inline-block"
        aria-label="RSS Feed"
        title="RSS Feed"
      >
        <IconRss
          width={20}
          height={20}
          class="stroke-accent scale-125 stroke-3 rtl:-rotate-90"
        />
        <span class="sr-only">RSS Feed</span>
      </a>

      <div class="flex flex-col gap-5 sm:flex-row sm:items-start sm:gap-7">
        <Image
          src={portrait}
          alt="Grégoire Hébert sur scène, micro à la main"
          widths={[128, 256, 384]}
          sizes="(max-width: 640px) 7rem, 9rem"
          loading="eager"
          class="border-border size-28 shrink-0 rounded-full border object-cover sm:size-36"
        />
        {
          /*
          Both versions ship in the HTML and a script below picks one from
          navigator.languages. There is no server to negotiate with on Pages,
          and French stays the rendered default for crawlers and for no-JS.
        */
        }
        <div>
          <div lang="fr" data-intro="fr">
            <p>
              Principal Engineer à <a
                class="hover:text-accent underline decoration-dashed underline-offset-4"
                href="https://les-tilleuls.coop"
                target="_blank"
                rel="noopener">Les-Tilleuls.coop</a
              >, à Lille. J'écris ici sur PHP, Symfony, API&nbsp;Platform,
              l'architecture logicielle et la conception d'API — avec, de temps
              en temps, un détour par les maths, le web d'avant ou un meuble en
              bois.
            </p>
            <p class="mt-2">
              Je suis aussi l'auteur de <LinkButton
                class="hover:text-accent underline decoration-dashed underline-offset-4"
                href={getRelativeLocaleUrl(locale, "blog/memex")}
              >
                Memex — La route du REST
              </LinkButton>, et je suis disponible pour du <LinkButton
                class="hover:text-accent underline decoration-dashed underline-offset-4"
                href={getRelativeLocaleUrl(locale, "hire-me")}
              >
                conseil, de l'audit et de la formation
              </LinkButton>.
            </p>
          </div>
          <div lang="en" data-intro="en" hidden>
            <p>
              Principal Engineer at <a
                class="hover:text-accent underline decoration-dashed underline-offset-4"
                href="https://les-tilleuls.coop"
                target="_blank"
                rel="noopener">Les-Tilleuls.coop</a
              >, in Lille, France. I write here about PHP, Symfony,
              API&nbsp;Platform, software architecture and API design — with the
              occasional detour through maths, the early web, or a piece of
              furniture.
            </p>
            <p class="mt-2">
              I am also the author of <LinkButton
                class="hover:text-accent underline decoration-dashed underline-offset-4"
                href={getRelativeLocaleUrl(locale, "blog/memex")}
              >
                Memex — La route du REST
              </LinkButton>, and I am available for <LinkButton
                class="hover:text-accent underline decoration-dashed underline-offset-4"
                href={getRelativeLocaleUrl(locale, "hire-me")}
              >
                consulting, audits and training
              </LinkButton>.
            </p>
          </div>
        </div>
      </div>
      <script is:inline data-astro-rerun>
        (function () {
          var intros = document.querySelectorAll("[data-intro]");
          if (!intros.length) return;

          var list =
            navigator.languages && navigator.languages.length
              ? navigator.languages
              : [navigator.language || "fr"];

          // First stated preference wins. Anyone who does not ask for French
          // gets English, which is likelier to be readable than French.
          var picked = "en";
          for (var i = 0; i < list.length; i++) {
            var tag = String(list[i]).toLowerCase();
            if (tag.indexOf("fr") === 0) {
              picked = "fr";
              break;
            }
            if (tag.indexOf("en") === 0) {
              picked = "en";
              break;
            }
          }

          for (var j = 0; j < intros.length; j++) {
            intros[j].hidden = intros[j].dataset.intro !== picked;
          }
        })();
      </script>

      {
        socials.length > 0 && (
          <div class="mt-4 flex max-sm:flex-col sm:items-center">
            <div class="me-2 mb-1 whitespace-nowrap sm:mb-0">
              {t.home.socialLinks}:
            </div>
            <Socials />
          </div>
        )
      }
    </section>

    {
      featuredPosts.length > 0 && (
        <section
          id="featured"
          class:list={[
            "pt-12 pb-6",
            { "border-border border-b": recentPosts.length > 0 },
          ]}
        >
          <h2 class="text-2xl font-semibold tracking-wide">
            {t.home.featured}
          </h2>
          <ul>
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-12 pb-6">
          <h2 class="text-2xl font-semibold tracking-wide">
            {t.home.recentPosts}
          </h2>
          <ul>
            {recentPosts.slice(0, postsConfig.perIndex).map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    <div class="my-8 text-center">
      <LinkButton href={getRelativeLocaleUrl(locale, "blog")}>
        {t.home.allPosts}
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
