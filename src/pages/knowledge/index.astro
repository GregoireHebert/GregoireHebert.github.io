    color: var(--kg-api);
  }
  .kg-chip-practice[aria-pressed="true"] {
    color: var(--kg-practice);
  }
  .kg-chip-field[aria-pressed="true"] {
    color: var(--kg-field);
  }
  .kg-chip-bridge[aria-pressed="true"] {
    color: var(--kg-bridge);
  }

  .kg-tools {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .kg-search input {
    width: 11rem;
    padding: 0.32rem 0.6rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: transparent;
    color: inherit;
    font: inherit;
    font-size: 0.82rem;
  }
  .kg-btn {
    min-width: 2rem;
    height: 2rem;
    padding-inline: 0.5rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: transparent;
    color: inherit;
    font: inherit;
    font-size: 0.9rem;
