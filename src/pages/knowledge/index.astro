  }
  .kg-btn:hover {
    border-color: var(--muted-foreground);
  }
  .kg-btn-wide {
    font-size: 0.8rem;
  }

  .kg-stage {
    position: relative;
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    overflow: hidden;
  }
  #kg-canvas {
    width: 100%;
    height: clamp(420px, 72vh, 760px);
