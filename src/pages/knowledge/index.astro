---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import OutlineBranch from "./_components/OutlineBranch.astro";
import config from "@/config";
import {
  nodes,
  edges,
  stats,
  ROOTS,
  type GraphNode,
} from "@/data/knowledge-graph";

const title = "Knowledge graph";
const description =
  "What I know about the web, APIs, engineering practice and running systems in production — drawn as one graph you can pan and zoom.";

const childrenOf = new Map<string, GraphNode[]>();
for (const node of nodes) {
  if (node.parent === null) continue;
  const siblings = childrenOf.get(node.parent) ?? [];
  siblings.push(node);
  childrenOf.set(node.parent, siblings);
}

const roots = (["api", "practice", "field"] as const).map(source => ({
  meta: ROOTS[source],
  node: nodes.find(n => n.id === ROOTS[source].id) as GraphNode,
}));

const payload = {
  nodes: nodes.map(n => ({
    id: n.id,
    label: n.label,
    up: n.parent,
    source: n.source,
    depth: n.depth,
    note: n.note ?? null,
  })),
  edges: edges.map(e => ({
    id: e.id,
    source: e.source,
    target: e.target,
    kind: e.kind,
    why: e.why ?? null,
  })),
};
---

<Layout title={`${title} | ${config.site.title}`} description={description}>
  <Header />
  <Breadcrumb />

  <Main pageTitle={title} pageDesc="what I know, drawn as a map">
    <p class="mb-4">
      This is my knowledge, gathered over the years and laid out in one place.
      It began as the board I kept while writing the book on REST, and it has
      taken on everything since: what the web is made of, how a model is
      shaped, how a message crosses a boundary, how a system is kept standing
      once people depend on it.
    </p>
    <p class="mb-6">
      Three areas, one graph. The dashed edges are the point — each joins an
      idea in one area to the place it is put to work in another. Drag to pan,
      scroll to zoom, click any node to read what it is.
    </p>

    <dl class="kg-stats">
      <div><dt>nodes</dt><dd>{stats.nodes}</dd></div>
      <div><dt>web and API design</dt><dd>{stats.apiNodes}</dd></div>
      <div><dt>engineering practice</dt><dd>{stats.practiceNodes}</dd></div>
      <div><dt>production</dt><dd>{stats.fieldNodes}</dd></div>
      <div><dt>bridges</dt><dd>{stats.bridges}</dd></div>
    </dl>
  </Main>

  <section class="kg" aria-labelledby="kg-heading">
    <h2 id="kg-heading" class="sr-only">The graph</h2>

    <div class="kg-controls">
      <div class="kg-chips" role="group" aria-label="Filter the graph">
        <button type="button" class="kg-chip" data-kg-source="all" aria-pressed="true">
          Everything
        </button>
        {
          roots.map(({ meta }) => (
            <button
              type="button"
              class={`kg-chip kg-chip-${meta.id}`}
              data-kg-source={meta.id}
              aria-pressed="false"
            >
              <span class="kg-swatch" aria-hidden="true"></span>
              {meta.label}
            </button>
          ))
        }
        <button type="button" class="kg-chip kg-chip-bridge" data-kg-bridges aria-pressed="false">
          <span class="kg-swatch" aria-hidden="true"></span>
          Bridges only
        </button>
      </div>

      <div class="kg-tools">
        <label class="kg-search">
          <span class="sr-only">Search the graph</span>
          <input
            type="search"
            id="kg-search"
            placeholder="Search…"
            autocomplete="off"
            spellcheck="false"
          />
        </label>
        <button type="button" class="kg-btn" data-kg-zoom="in" aria-label="Zoom in">+</button>
        <button type="button" class="kg-btn" data-kg-zoom="out" aria-label="Zoom out">−</button>
        <button type="button" class="kg-btn kg-btn-wide" data-kg-fit>Fit</button>
      </div>
    </div>

    <div class="kg-stage">
      <div
        id="kg-canvas"
        role="img"
        aria-label={`A force-directed graph of ${stats.nodes} nodes covering the web and API design, engineering practice, and running systems in production. The same content is listed below the graph.`}
      >
      </div>
      <p class="kg-status" id="kg-status" role="status">Laying out the graph…</p>
      <p class="kg-hint">Drag to pan · scroll to zoom · click a node</p>
    </div>

    <div class="kg-readout" id="kg-readout" aria-live="polite">
      <p class="kg-readout-path" id="kg-readout-path"></p>
      <p class="kg-readout-name" id="kg-readout-name">Nothing selected</p>
      <p class="kg-readout-note" id="kg-readout-note">
        Click a node in the graph, or any entry in the index below.
      </p>
      <ul class="kg-readout-bridges" id="kg-readout-bridges"></ul>
    </div>
  </section>

  <Main class="mt-12">
    <h2 class="text-xl font-semibold tracking-wide" id="kg-index">The index</h2>
    <p class="mt-2 mb-6 italic">
      The same graph, in reading order. Every entry selects itself in the map
      above, where its description and its bridges are shown.
    </p>

    <div class="kg-outline">
      {
        roots.map(({ meta, node }) => (
          <section class={`kg-root kg-root-${meta.id}`}>
            <h3>{meta.label}</h3>
            <p class="kg-root-blurb">{meta.blurb}</p>
            <ul class="kg-children">
              {(childrenOf.get(node.id) ?? []).map(domain => (
                <OutlineBranch node={domain} childrenOf={childrenOf} />
              ))}
            </ul>
          </section>
        ))
      }
    </div>


    <p class="mt-10 text-sm opacity-80">
      The web and API half of this map is also kept on
      <a href="https://miro.com/app/board/uXjVMW-gn64=/">Miro</a>, where it was
      first drawn.
    </p>
  </Main>

  <Footer />
</Layout>

<script type="application/json" id="kg-data" is:inline set:html={JSON.stringify(payload)} />

<style is:global>
  :root {
    --kg-api: #0f6f7d;
    --kg-practice: #a8561b;
    --kg-field: #2f6b4f;
    --kg-bridge: #63479a;
  }
  [data-theme="dark"] {
    --kg-api: #49c1d0;
    --kg-practice: #e19b57;
    --kg-field: #6fbf96;
    --kg-bridge: #ac90e2;
  }

  .kg-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2rem;
    margin: 0;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
  }
  .kg-stats dt {
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted-foreground);
  }
  .kg-stats dd {
    margin: 0;
    font-size: 1.3rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .kg {
    width: 100%;
    max-width: 1400px;
    margin: 2rem auto 0;
    padding-inline: 1rem;
  }

  .kg-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }
  .kg-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .kg-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.3rem 0.7rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: transparent;
    color: var(--muted-foreground);
    font: inherit;
    font-size: 0.82rem;
    line-height: 1.4;
  }
  .kg-chip:hover {
    color: var(--foreground);
    border-color: var(--muted-foreground);
  }
  .kg-chip[aria-pressed="true"] {
    color: var(--foreground);
    border-color: currentColor;
  }
  .kg-swatch {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 2px;
    background: currentColor;
  }
