---
import LinkButton from "@/components/LinkButton.astro";
import T from "@/components/T.astro";
import { i18nAttrs, tr } from "@/i18n/dual";
import { tplStr } from "@/i18n";
import { stripPageExtension } from "@/utils/withBase";
import config from "@/config";

const { shareLinks } = config;

const icons = import.meta.glob<{
  default: (_props: Record<string, unknown>) => unknown;
}>("/src/assets/icons/socials/*.svg");

// share the advertised URL, not the .html file behind it
const pageUrl = new URL(stripPageExtension(Astro.url.pathname), Astro.url);

const platformLabel = (name: string) =>
  name.charAt(0).toUpperCase() + name.slice(1);

const items = await Promise.all(
  shareLinks.map(async ({ name, url, linkTitle }) => {
    const mod = await icons[`/src/assets/icons/socials/${name}.svg`]?.();
    const Icon = mod?.default;
    const label = (lang: "fr" | "en") =>
      linkTitle ??
      (name === "mail"
        ? tr(lang, "post.sharePostViaEmail")
        : tplStr(tr(lang, "post.sharePostOn"), {
            platform: platformLabel(name),
          }));
    return { url, titleFr: label("fr"), titleEn: label("en"), Icon };
  })
);
---

{
  items.some(({ Icon }) => Icon) && (
    <div class="flex flex-none flex-col items-center justify-center gap-1 md:items-start">
      <span class="italic">
        <T k="post.sharePostIntro" />
      </span>
      <div class="text-center">
        {items.map(({ url, titleFr, titleEn, Icon }) =>
          Icon ? (
            <LinkButton
              href={`${url}${pageUrl}`}
              class="scale-90 p-2 hover:rotate-6 sm:p-1"
              {...i18nAttrs({ title: [titleFr, titleEn] })}
              target="_blank"
              rel="noopener noreferrer"
            >
              <Icon class="inline-block size-6 scale-125 fill-transparent stroke-current stroke-2 opacity-90 group-hover:fill-transparent sm:scale-110" />
              <span class="sr-only">
                <span data-l="fr">{titleFr}</span>
                <span data-l="en">{titleEn}</span>
              </span>
            </LinkButton>
          ) : null
        )}
      </div>
    </div>
  )
}
