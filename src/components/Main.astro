---
import { getRelativeLocaleUrl } from "astro:i18n";
import { stripPageExtension } from "@/utils/withBase";
import T from "./T.astro";
import config from "@/config";

type Props = {
  /** Literal heading, for pages whose title is not a UI string. */
  pageTitle?: string | [string, string];
  pageDesc?: string;
  /** i18n keys, for pages whose heading follows the reader's language. */
  titleKey?: string;
  descKey?: string;
  class?: string;
};

const {
  pageTitle,
  pageDesc,
  titleKey,
  descKey,
  class: className,
} = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
const backUrl = config.features.showBackButton
  ? stripPageExtension(Astro.url.pathname)
  : getRelativeLocaleUrl(locale, "");
---

<main
  data-backUrl={backUrl}
  id="main-content"
  class:list={["app-layout pb-4", className]}
>
  <h1 class="text-2xl font-semibold sm:text-3xl">
    {
      Astro.slots.has("title") ? (
        <slot name="title" />
      ) : titleKey ? (
        <T k={titleKey} />
      ) : (
        pageTitle
      )
    }
  </h1>
  <p class="mt-2 mb-6 italic">
    {
      Astro.slots.has("desc") ? (
        <slot name="desc" />
      ) : descKey ? (
        <T k={descKey} />
      ) : (
        pageDesc
      )
    }
  </p>
  <slot />
</main>

<script>
  document.addEventListener("astro:page-load", () => {
    const mainContent: HTMLElement | null =
      document.querySelector("#main-content");
    const backUrl = mainContent?.dataset?.backurl;
    if (backUrl) {
      sessionStorage.setItem("backUrl", backUrl);
    }
  });
</script>
