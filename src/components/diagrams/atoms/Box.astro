---
/**
 * A labelled rectangle on the diagram grid. The only way the series draws a
 * box, which is what stops chapter sixty-one from inventing a second one.
 */
interface Props {
  x: number;
  y: number;
  w: number;
  h: number;
  label?: string;
  sub?: string;
  variant?: "default" | "focus" | "warn";
  small?: boolean;
  fill?: boolean;
  delay?: number;
  id?: string;
  class?: string;
}

const {
  x,
  y,
  w,
  h,
  label,
  sub,
  variant = "default",
  small = false,
  fill = true,
  delay,
  id,
  class: className,
} = Astro.props;

const emphasis =
  variant === "focus" ? "is-focus" : variant === "warn" ? "is-warn" : undefined;
const style = delay === undefined ? undefined : `--dia-delay:${delay}ms`;
---

<g data-box={id} class={className} style={style}>
  <rect
    x={x}
    y={y}
    width={w}
    height={h}
    rx="var(--dia-radius)"
    class:list={["dia-box", emphasis]}
    style={fill ? undefined : "fill:none"}></rect>
  {
    label && (
      <text
        x={x + w / 2}
        y={sub ? y + h / 2 - 7 : y + h / 2}
        class:list={["dia-label", small && "dia-label--sm", emphasis]}
      >
        {label}
      </text>
    )
  }
  {
    sub && (
      <text x={x + w / 2} y={y + h / 2 + 7} class="dia-label dia-label--soft">
        {sub}
      </text>
    )
  }
</g>
