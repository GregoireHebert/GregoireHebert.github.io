---
/**
 * One way of getting a value from one context to another. The event and the
 * replication panels are deliberately the same drawing, because they are the
 * same mechanism: only the intention behind them differs.
 */
import Frame from "./atoms/Frame.astro";
import Box from "./atoms/Box.astro";
import Arrow from "./atoms/Arrow.astro";

interface Props {
  kind: "event" | "replication" | "service";
  title: string;
}

const { kind, title } = Astro.props;
const publishes = kind !== "service";
---

<Frame viewBox="0 0 164 104" title={title}>
  <Box x={8} y={26} w={48} h={32} label="A" />
  <Box x={108} y={26} w={48} h={32} label="B" />

  {
    publishes && (
      <>
        <Arrow x1={60} y1={42} x2={104} y2={42} variant="focus" id="publish" />
        <circle
          cx="66"
          cy="42"
          r="3"
          fill="var(--dia-focus)"
          class="dia-anim-travel"
          style="--dia-travel:32px"
        />
        <Box x={108} y={70} w={48} h={22} label="store" variant="default" />
        <line x1="132" y1="58" x2="132" y2="70" class="dia-line" />
      </>
    )
  }

  {
    !publishes && (
      <>
        <Arrow x1={104} y1={34} x2={60} y2={34} id="ask" />
        <Arrow x1={60} y1={52} x2={104} y2={52} variant="focus" id="answer" />
        <text x={82} y={78} class="dia-label dia-label--soft">
          synchronous
        </text>
      </>
    )
  }

  <slot name="caption" slot="caption" />
</Frame>
