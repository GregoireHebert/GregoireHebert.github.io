---
import type { Page } from "astro";
import type { CollectionEntry } from "astro:content";
import IconArrowLeft from "@/assets/icons/IconArrowLeft.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import LinkButton from "./LinkButton.astro";
import T from "./T.astro";
import { i18nAttrs } from "@/i18n/dual";

type Props = {
  page: Page<CollectionEntry<"posts">>;
};

const { page } = Astro.props;
---

{
  page.lastPage > 1 && (
    <nav
      class="mt-auto mb-8 flex justify-center gap-4"
      role="navigation"
      aria-label="Pagination Navigation"
    >
      <LinkButton
        disabled={!page.url.prev}
        href={page.url.prev as string}
        class:list={["select-none", { "opacity-50": !page.url.prev }]}
        {...i18nAttrs({ "aria-label": "a11y.goToPreviousPage" })}
      >
        <IconArrowLeft class="inline-block rtl:rotate-180" />
        <T k="pagination.prev" />
      </LinkButton>
      {page.currentPage} / {page.lastPage}
      <LinkButton
        disabled={!page.url.next}
        href={page.url.next as string}
        class:list={["select-none", { "opacity-50": !page.url.next }]}
        {...i18nAttrs({ "aria-label": "a11y.goToNextPage" })}
      >
        <T k="pagination.next" />
        <IconArrowRight class="inline-block rtl:rotate-180" />
      </LinkButton>
    </nav>
  )
}
