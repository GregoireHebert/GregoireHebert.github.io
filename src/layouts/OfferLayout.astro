---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import LinkButton from "@/components/LinkButton.astro";
import IconArrowLeft from "@/assets/icons/IconArrowLeft.svg";
import { getRelativeLocaleUrl } from "astro:i18n";
import config from "@/config";

type Props = {
  title: string;
  subtitle: string;
  description: string;
  price?: string;
};

const { title, subtitle, description, price } = Astro.props;
const locale = Astro.currentLocale ?? config.site.lang;
---

<Layout title={`${title} | ${config.site.title}`} description={description}>
  <Header />

  <Breadcrumb />

  <Main pageTitle={title} pageDesc={subtitle}>
    {
      price && (
        <p class="text-accent mb-6 text-2xl font-bold sm:text-3xl">{price}</p>
      )
    }

    <div class="app-prose max-w-app">
      <slot />
    </div>

    <hr class="my-8 border-dashed" />

    <LinkButton
      href={getRelativeLocaleUrl(locale, "hire-me")}
      class="hover:text-accent underline decoration-dashed underline-offset-4"
    >
      <IconArrowLeft class="inline-block size-5 rtl:-rotate-180" />
      Back to all offers
    </LinkButton>
  </Main>

  <Footer />
</Layout>
